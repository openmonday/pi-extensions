{
  "name": "pi-trans",
  "version": "0.1.0",
  "description": "Display-only bilingual translation for the pi coding agent",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "translation",
    "bilingual"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmonday/pi-extensions.git",
    "directory": "pi-trans"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "src/",
    "panel/Cargo.toml",
    "panel/Cargo.lock",
    "panel/src/",
    "panel/popup.html",
    "panel/bin/",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "marked": "^18.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
