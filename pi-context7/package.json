{
  "name": "pi-context7",
  "version": "0.1.0",
  "description": "Context7 extension for pi.dev — adds resolve-library-id and query-docs tools to the pi coding agent",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmonday/pi-extensions.git",
    "directory": "pi-context7"
  },
  "keywords": [
    "pi-package",
    "context7",
    "documentation",
    "upstash",
    "ai",
    "coding-agent"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/openmonday/pi-extensions/issues"
  },
  "homepage": "https://github.com/openmonday/pi-extensions/tree/main/pi-context7#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "typebox": "^1.4.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}